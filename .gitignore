# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# test folders
/tests
/Testing
/.playwright/
/outputs
/output

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# uploaded user files — never commit
private/uploads/**
public/uploads/**

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local scratch/export artifacts
scratch/
database/*.sql
loantrack_export*.sql

# local git worktrees
.worktrees/

# Flutter mobile app (mobile/)
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.idea/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/release/
mobile/**/GeneratedPluginRegistrant.*
mobile/.vscode/
*.log
*.yml

# Build artifacts / large binaries — never commit
*.zip
mobile/firebase_sdk.zip
mobile/mobile.zip
loanapp-standalone-hostinger.zip
loanapp.zip
loanapp_source_*.zip
app.zip
app_01.zip
prototype.zip
loantrack_end_to_end_markdown_docs.zip
