# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# test OUTPUT folders (not the /tests source dir — that is committed)
/Testing
/.playwright/
/outputs
/output

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# uploaded user files — never commit
private/uploads/**
public/uploads/**

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local scratch/export artifacts
scratch/
scratch.js
database/
tmp/
loantrack_export*.sql
# test / build reports
playwright-report/
test-results/
# db dumps & patches at root
*backup*.sql
*.patch

# local git worktrees
.worktrees/

# Flutter mobile app (mobile/)
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.idea/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/release/
mobile/**/GeneratedPluginRegistrant.*
mobile/.vscode/
*.log
*.yml
*.zip
# GitHub Actions workflows must be committed — exclude them from the *.yml ignore above.
!.github/workflows/*.yml
# Devcontainer compose file must be committed — exclude it from the *.yml ignore above.
!.devcontainer/*.yml
*.apk
*.html
loantrack_marketing_page_en.html

# Flutter: ignore GENERATED dart only — hand-written *.dart source IS committed.
mobile/**/*.g.dart
mobile/**/*.freezed.dart
mobile/**/*.mocks.dart
mobile/**/*.config.dart
mobile/lib/data/services/fcm_service.dart
mobile/pubspec.lock
mobile/windows/flutter/generated_plugin_registrant.cc
mobile/windows/flutter/generated_plugins.cmake

# executables
mobile/nuget.exe
*.exe

# SQL: ignore DB DUMPS only (loantrack_export*.sql / *backup*.sql above).
# Prisma migrations and docs/*.sql ARE committed.

# Playwright
node_modules/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# self-healing SDLC loop state/artifacts
/e2e-results/
scripts/self-heal/.state/
