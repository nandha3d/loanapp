  creditScore      Int?      @map("credit_score")
  scoreModel       String?   @map("score_model")
  totalAccounts    Int?      @map("total_accounts")
  activeAccounts   Int?      @map("active_accounts")
  overdueAccounts  Int?      @map("overdue_accounts")
  totalOverdueAmt  Decimal?  @map("total_overdue_amt")  @db.Decimal(12, 2)
  enquiryCount90d  Int?      @map("enquiry_count_90d")
  activeMFILoans   Int?      @map("active_mfi_loans")
  activeMFILoanAmt Decimal?  @map("active_mfi_loan_amt") @db.Decimal(12, 2)
  writtenOffAccounts Int?    @map("written_off_accounts")
  suitFiledAccounts  Int?    @map("suit_filed_accounts")

  rawResponse      String?   @map("raw_response") @db.LongText

  consentText      String    @map("consent_text") @db.Text
  consentObtained  Boolean   @default(false) @map("consent_obtained")
  consentTimestamp DateTime? @map("consent_timestamp")
  consentIp        String?   @map("consent_ip")
  consentMethod    String?   @map("consent_method")

  validUntil       DateTime  @map("valid_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  linkedLoans      Loan[]    @relation("LoanBureauReport")
  linkedInstalments Instalment[] @relation("InstalmentBureauReport")

  @@index([customerId, createdAt])
  @@index([tenantId, createdAt])
  @@map("bureau_reports")
}

/// NPA classification history — immutable audit trail for RBI inspection.
/// Records every classification change (Standard → SMA → Sub-Standard → Doubtful etc.).
model NpaHistory {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  loanId          String    @map("loan_id")
  customerId      String    @map("customer_id")

  // Transition recorded
  fromCategory    String    @map("from_category")
  toCategory      String    @map("to_category")
  daysOverdue     Int       @map("days_overdue")
  outstandingAmt  Decimal   @map("outstanding_amt") @db.Decimal(12, 2)

  // Trigger information
  triggeredBy     String    @map("triggered_by")    // 'cron_auto' | 'manual_admin' | 'rbi_inspection'
  triggeredById   String?   @map("triggered_by_id") // userId if manual
  notes           String?   @db.Text

  // Provisioning at time of change
  provisioningRate    Decimal @map("provisioning_rate") @db.Decimal(6, 2)
  provisioningAmount  Decimal @map("provisioning_amount") @db.Decimal(12, 2)

  createdAt       DateTime  @default(now()) @map("created_at")

  loan            Loan      @relation(fields: [loanId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([loanId, createdAt])
  @@index([tenantId, toCategory, createdAt])
  @@map("npa_history")
}

/// Daily provisioning snapshot per loan for RBI point-in-time reporting.
/// One snapshot per loan per day. Immutable — cannot be modified once written.
model LoanProvisioning {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  loanId          String    @map("loan_id")
  snapshotDate    DateTime  @map("snapshot_date") @db.Date

  category        String    // asset category at snapshot
  outstandingAmt  Decimal   @map("outstanding_amt") @db.Decimal(12, 2)
  provisioningRate Decimal  @map("provisioning_rate") @db.Decimal(6, 2)
  provisioningAmt  Decimal  @map("provisioning_amt") @db.Decimal(12, 2)
  isSecured       Boolean   @default(false) @map("is_secured")

  createdAt       DateTime  @default(now()) @map("created_at")

  loan            Loan      @relation(fields: [loanId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([loanId, snapshotDate])
  @@index([tenantId, snapshotDate])
  @@map("loan_provisioning")
}

model KycSession {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  customerId      String    @map("customer_id")
  method          String                         // 'aadhaar_otp' | 'video_kyc'
  status          String    @default("initiated")
  // 'initiated' | 'otp_sent' | 'otp_verified' | 'failed'
  // 'video_uploaded' | 'video_reviewing' | 'video_approved' | 'video_rejected'

  // Digio fields
  digioRequestId  String?   @map("digio_request_id")  // Digio session/request ID
  digioEntityId   String?   @map("digio_entity_id")

  // OTP fields
  otpReference    String?   @map("otp_reference")
  otpExpiresAt    DateTime? @map("otp_expires_at")

  // Video fields
  videoFilePath   String?   @map("video_file_path")
  videoFileName   String?   @map("video_file_name")
  videoUploadedAt DateTime? @map("video_uploaded_at")

  // Review fields
  reviewedById    String?   @map("reviewed_by_id")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewNotes     String?   @map("review_notes") @db.Text

  // Response data (stored as JSON string)
  responseData    String?   @map("response_data") @db.Text

  initiatedById   String?   @map("initiated_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  initiatedBy     User?     @relation("KycSessionInitiator", fields: [initiatedById], references: [id])
  reviewedBy      User?     @relation("KycSessionReviewer", fields: [reviewedById], references: [id])

  @@index([tenantId, customerId])
  @@index([digioRequestId])
  @@map("kyc_sessions")
}
