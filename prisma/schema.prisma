model BureauReport {
  id             String  @id @default(cuid())
  tenantId       String  @map("tenant_id")
  customerId     String  @map("customer_id")
  loanId         String? @map("loan_id")
  bureauProvider String  @map("bureau_provider")
  pullType       String  @map("pull_type")
  requestId      String  @unique @map("request_id")
  status         String  @default("pending")

  creditScore        Int?     @map("credit_score")
  scoreModel         String?  @map("score_model")
  totalAccounts      Int?     @map("total_accounts")
  activeAccounts     Int?     @map("active_accounts")
  overdueAccounts    Int?     @map("overdue_accounts")
  totalOverdueAmt    Decimal? @map("total_overdue_amt") @db.Decimal(12, 2)
  enquiryCount90d    Int?     @map("enquiry_count_90d")
  activeMFILoans     Int?     @map("active_mfi_loans")
  activeMFILoanAmt   Decimal? @map("active_mfi_loan_amt") @db.Decimal(12, 2)
