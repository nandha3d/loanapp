  quantity         Int      @default(1)
  grossWeightGrams Decimal  @default(0) @map("gross_weight_grams") @db.Decimal(12, 3)
  wastageGrams     Decimal  @default(0) @map("wastage_grams") @db.Decimal(12, 3)
  netWeightGrams   Decimal  @default(0) @map("net_weight_grams") @db.Decimal(12, 3)
  ratePerGram      Decimal  @default(0) @map("rate_per_gram") @db.Decimal(12, 2)
  value            Decimal  @default(0) @db.Decimal(14, 2)
