  branch     Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("SuperadminBranchAssigner", fields: [assignedById], references: [id])

  @@unique([superadminId, branchId])
  @@index([branchId])
  @@map("superadmin_branches")
}

/// Superadmin-assigned global module access for an admin or agent.
