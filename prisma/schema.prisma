generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String                 @default("LoanTrack")
  slug                  String                 @unique @default("default")
  status                String                 @default("active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  settings              AppSetting[]
  auditLogs             AuditLog[]
  branches              Branch[]
  chitGroups            ChitGroup[]
  customers             Customer[]
  collections           DailyCollection[]
  collectionEntries     CollectionEntry[]
  loanPackages          LoanPackage[]
  loans                 Loan[]
  notificationTemplates NotificationTemplate[]
  routes                Route[]
  notifications         SystemNotification[]
  subscription          TenantSubscription?
  users                 User[]
  vehicles              Vehicle[]
  deletedAt             DateTime?              @map("deleted_at")
  billingInvoices       BillingInvoice[]

  @@map("tenants")
}

model Branch {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  name        String
  code        String?
  address     String?           @db.Text
  phone       String?
  status      String            @default("active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chitGroups  ChitGroup[]
  customers   Customer[]
  collections DailyCollection[]
  loans       Loan[]
  routes      Route[]
  users       User[]

  @@unique([tenantId, code])
  @@map("branches")
}

model AppSetting {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  key       String
  value     String   @db.Text
  group     String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("app_settings")
}

model User {
  id                       String            @id @default(cuid())
  tenantId                 String            @map("tenant_id")
  branchId                 String?           @map("branch_id")
  name                     String
  phone                    String
  email                    String?
  username                 String
  passwordHash             String            @map("password_hash")
  totpSecret               String?           @map("totp_secret")
  role                     String            @default("agent")
  appType                  String            @default("microlending") @map("app_type")
  status                   String            @default("active")
  avatar                   String?
  lastLoginAt              DateTime?         @map("last_login_at")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  approvalRequestsMade     ApprovalRequest[] @relation("Requester")
  approvalRequestsReviewed ApprovalRequest[] @relation("Reviewer")
  auditLogs                AuditLog[]
  collectionEntries        CollectionEntry[]
  assignedCustomers        Customer[]        @relation("AgentCustomers")
  dailyCollections         DailyCollection[]
  createdLoans             Loan[]            @relation("LoanCreator")
  settledPenalties         Penalty[]         @relation("PenaltySettler")
  routeAgents              RouteAgent[]
  assignedRoutes           Route[]
  branch                   Branch?           @relation(fields: [branchId], references: [id])
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleRepoFlags         Vehicle[]         @relation("VehicleRepoFlag")
  deletedAt                DateTime?         @map("deleted_at")

  @@unique([tenantId, username])
  @@unique([tenantId, phone])
  @@index([branchId], map: "users_branch_id_fkey")
  @@map("users")
}

model Route {
  id               String            @id @default(cuid())
  tenantId         String            @map("tenant_id")
  branchId         String?           @map("branch_id")
  name             String
  assignedAgentId  String?           @map("assigned_agent_id")
  status           String            @default("active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  appType          String            @default("microlending") @map("app_type")
  customers        Customer[]
  dailyCollections DailyCollection[]
  routeAgents      RouteAgent[]
  assignedAgent    User?             @relation(fields: [assignedAgentId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([assignedAgentId], map: "routes_assigned_agent_id_fkey")
  @@index([branchId], map: "routes_branch_id_fkey")
  @@index([tenantId], map: "routes_tenant_id_fkey")
  @@map("routes")
}

model Customer {
  id                String            @id @default(cuid())
  tenantId          String            @map("tenant_id")
  branchId          String?           @map("branch_id")
  customerCode      String            @map("customer_code")
  name              String
  phone             String
  address           String?           @db.Text
  aadharNumber      String?           @map("aadhar_number")
  pan               String?           @map("pan")
  routeId           String?           @map("route_id")
  agentId           String?           @map("agent_id")
  kycStatus         String            @default("pending")
  profilePhoto      String?           @map("profile_photo")
  userId            String?           @unique @map("user_id")
  status            String            @default("active")
  notes             String?           @db.Text
  appType           String            @default("microlending") @map("app_type")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  chitGroupMembers  ChitMember[]
  collectionEntries CollectionEntry[]
  agent             User?             @relation("AgentCustomers", fields: [agentId], references: [id])
  branch            Branch?           @relation(fields: [branchId], references: [id])
  route             Route?            @relation(fields: [routeId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guarantors        Guarantor[]
  kycDocuments      KycDocument[]
  loans             Loan[]
  penalties         Penalty[]
  securityCheques   SecurityCheque[]
  vehicles          Vehicle[]
  deletedAt         DateTime?         @map("deleted_at")

  @@unique([tenantId, customerCode])
  @@index([agentId], map: "customers_agent_id_fkey")
  @@index([branchId], map: "customers_branch_id_fkey")
  @@index([routeId], map: "customers_route_id_fkey")
  @@map("customers")
}

model KycDocument {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  docType    String   @map("doc_type")
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  fileSize   Int?     @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "kyc_documents_customer_id_fkey")
  @@map("kyc_documents")
}

model SecurityCheque {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  bankName     String   @map("bank_name")
  chequeNumber String   @map("cheque_number")
  amount       Decimal? @db.Decimal(12, 2)
  imagePath    String?  @map("image_path")
  status       String   @default("active")
  notes        String?
  loanId       String?  @map("loan_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loan         Loan?    @relation(fields: [loanId], references: [id])

  @@index([customerId], map: "security_cheques_customer_id_fkey")
  @@map("security_cheques")
}

model LoanPackage {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  name          String
  principal     Decimal  @db.Decimal(12, 2)
  deduction     Decimal  @db.Decimal(12, 2)
  deductionType String   @default("fixed") @map("deduction_type")
  frequency     String
  tenure        Int
  perInstalment Decimal  @map("per_instalment") @db.Decimal(12, 2)
  penaltyRate   Decimal  @map("penalty_rate") @db.Decimal(12, 2)
  appType       String   @default("microlending") @map("app_type")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans         Loan[]

  @@index([tenantId], map: "loan_packages_tenant_id_fkey")
  @@map("loan_packages")
}

model Loan {
  id                String            @id @default(cuid())
  tenantId          String            @map("tenant_id")
  branchId          String?           @map("branch_id")
  loanCode          String            @map("loan_code")
  customerId        String            @map("customer_id")
  packageId         String?           @map("package_id")
  loanType          String            @default("cheque") @map("loan_type")
  appType           String            @default("microlending") @map("app_type")
  collateralDetails String?           @map("collateral_details") @db.Text
  guarantorId       String?           @map("guarantor_id")
  principal         Decimal           @db.Decimal(12, 2)
  deduction         Decimal           @db.Decimal(12, 2)
  deductionType     String            @default("fixed") @map("deduction_type")
  disbursed         Decimal           @db.Decimal(12, 2)
  frequency         String
  tenure            Int
  startDate         DateTime          @map("start_date") @db.Date
  endDate           DateTime?         @map("end_date") @db.Date
  perInstalment     Decimal           @map("per_instalment") @db.Decimal(12, 2)
  penaltyRate       Decimal           @map("penalty_rate") @db.Decimal(12, 2)
  totalPayable      Decimal           @default(0.00) @map("total_payable") @db.Decimal(12, 2)
  voucherRef        String?           @map("voucher_ref")
  status            String            @default("active")
  paidCount         Int               @default(0) @map("paid_count")
  totalInstalments  Int               @map("total_instalments")
  totalCollected    Decimal           @default(0.00) @map("total_collected") @db.Decimal(12, 2)
  closedAt          DateTime?         @map("closed_at")
  npaClassifiedAt   DateTime?         @map("npa_classified_at")
  npaStatus         String?           @map("npa_status")
  deletedAt         DateTime?         @map("deleted_at")
  createdById       String?           @map("created_by_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  collectionEntries CollectionEntry[]
  instalments       Instalment[]
  collaterals       LoanCollateral[]
  payments          Payment[]
  securityCheques   SecurityCheque[]
  branch            Branch?           @relation(fields: [branchId], references: [id])
  createdBy         User?             @relation("LoanCreator", fields: [createdById], references: [id])
  customer          Customer          @relation(fields: [customerId], references: [id])
  guarantor         Guarantor?        @relation(fields: [guarantorId], references: [id])
  package           LoanPackage?      @relation(fields: [packageId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  penalties         Penalty[]
  vehicle           Vehicle?

  @@unique([tenantId, loanCode])
  @@index([branchId], map: "loans_branch_id_fkey")
  @@index([createdById], map: "loans_created_by_id_fkey")
  @@index([customerId], map: "loans_customer_id_fkey")
  @@index([guarantorId], map: "loans_guarantor_id_fkey")
  @@index([packageId], map: "loans_package_id_fkey")
  @@map("loans")
}

model Instalment {
  id                 String              @id @default(cuid())
  loanId             String              @map("loan_id")
  instalmentNo       Int                 @map("instalment_no")
  dueDate            DateTime            @map("due_date") @db.Date
  dueAmount          Decimal             @map("due_amount") @db.Decimal(12, 2)
  receivedAmount     Decimal             @default(0.00) @map("received_amount") @db.Decimal(12, 2)
  paymentMode        String?             @map("payment_mode")
  status             String              @default("upcoming")
  receivedAt         DateTime?           @map("received_at")
  agentId            String?             @map("agent_id")
  remarks            String?             @db.Text
  lockedAt           DateTime?           @map("locked_at")
  penaltyApplied     Boolean             @default(false) @map("penalty_applied")
  collectionEntryId  String?             @unique @map("collection_entry_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  collectionEntry    CollectionEntry?    @relation(fields: [collectionEntryId], references: [id])
  loan               Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  penalties          Penalty[]
  paymentAllocations PaymentAllocation[]

  @@unique([loanId, instalmentNo])
  @@index([dueDate])
  @@index([status])
  @@map("instalments")
}

model Penalty {
  id            String      @id @default(cuid())
  loanId        String      @map("loan_id")
  customerId    String      @map("customer_id")
  missedDays    Int         @default(0) @map("missed_days")
  grossPenalty  Decimal     @default(0.00) @map("gross_penalty") @db.Decimal(12, 2)
  settledAmount Decimal     @default(0.00) @map("settled_amount") @db.Decimal(12, 2)
  waivedAmount  Decimal     @default(0.00) @map("waived_amount") @db.Decimal(12, 2)
  status        String      @default("pending")
  settledById   String?     @map("settled_by_id")
  settledAt     DateTime?   @map("settled_at")
  instalmentId  String?     @map("instalment_id")
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  customer      Customer    @relation(fields: [customerId], references: [id])
  loan          Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  instalment    Instalment? @relation(fields: [instalmentId], references: [id])
  settledBy     User?       @relation("PenaltySettler", fields: [settledById], references: [id])

  @@index([customerId], map: "penalties_customer_id_fkey")
  @@index([loanId], map: "penalties_loan_id_fkey")
  @@index([settledById], map: "penalties_settled_by_id_fkey")
  @@map("penalties")
}

model DailyCollection {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  branchId       String?           @map("branch_id")
  agentId        String            @map("agent_id")
  routeId        String?           @map("route_id")
  date           DateTime          @db.Date
  totalExpected  Decimal           @default(0.00) @map("total_expected") @db.Decimal(12, 2)
  totalCollected Decimal           @default(0.00) @map("total_collected") @db.Decimal(12, 2)
  entriesCount   Int               @default(0) @map("entries_count")
  appType        String            @default("microlending") @map("app_type")
  status         String            @default("open")
  lockedAt       DateTime?         @map("locked_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  entries        CollectionEntry[]
  agent          User              @relation(fields: [agentId], references: [id])
  branch         Branch?           @relation(fields: [branchId], references: [id])
  route          Route?            @relation(fields: [routeId], references: [id])
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appType, agentId, date])
  @@index([date])
  @@index([branchId], map: "daily_collections_branch_id_fkey")
  @@index([routeId], map: "daily_collections_route_id_fkey")
  @@index([tenantId], map: "daily_collections_tenant_id_fkey")
  @@map("daily_collections")
}

model CollectionEntry {
  id             String          @id @default(cuid())
  tenantId       String          @map("tenant_id")
  collectionId   String          @map("collection_id")
  customerId     String          @map("customer_id")
  loanId         String          @map("loan_id")
  dueAmount      Decimal         @map("due_amount") @db.Decimal(12, 2)
  receivedAmount Decimal         @map("received_amount") @db.Decimal(12, 2)
  paymentMode    String          @default("cash") @map("payment_mode")
  remarks        String?         @db.Text
  agentId        String          @map("agent_id")
  submittedAt    DateTime        @default(now()) @map("submitted_at")
  isLocked       Boolean         @default(true) @map("is_locked")
  agent          User            @relation(fields: [agentId], references: [id])
  collection     DailyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id])
  loan           Loan            @relation(fields: [loanId], references: [id])
  instalment     Instalment?
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([agentId], map: "collection_entries_agent_id_fkey")
  @@index([collectionId], map: "collection_entries_collection_id_fkey")
  @@index([customerId], map: "collection_entries_customer_id_fkey")
  @@index([loanId], map: "collection_entries_loan_id_fkey")
  @@index([tenantId])
  @@map("collection_entries")
}

model SystemNotification {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  appType   String    @default("microlending") @map("app_type")
  type      String
  icon      String?
  title     String?
  message   String    @db.Text
  link      String?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, appType, isRead])
  @@index([createdAt])
  @@map("system_notifications")
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  channel   String
  subject   String?
  body      String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, channel])
  @@map("notification_templates")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, entityType])
  @@index([createdAt])
  @@index([userId], map: "audit_logs_user_id_fkey")
  @@map("audit_logs")
}

model Guarantor {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  name         String
  phone        String
  address      String?  @db.Text
  aadharNumber String?  @map("aadhar_number")
  photo        String?
  relation     String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loans        Loan[]

  @@index([customerId], map: "guarantors_customer_id_fkey")
  @@map("guarantors")
}

model LoanCollateral {
  id          String   @id @default(cuid())
  loanId      String   @map("loan_id")
  docType     String   @map("doc_type")
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  fileSize    Int?     @map("file_size")
  description String?
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId], map: "loan_collaterals_loan_id_fkey")
  @@map("loan_collaterals")
}

model ApprovalRequest {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  appType          String    @map("app_type")
  requestType      String    @map("request_type")
  entityType       String    @map("entity_type")
  entityId         String    @map("entity_id")
  requestedById    String    @map("requested_by_id")
  requestedChanges String    @map("requested_changes") @db.Text
  reason           String?   @db.Text
  status           String    @default("pending")
  reviewedById     String?   @map("reviewed_by_id")
  reviewedAt       DateTime? @map("reviewed_at")
  reviewNotes      String?   @map("review_notes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  requestedBy      User      @relation("Requester", fields: [requestedById], references: [id])
  reviewedBy       User?     @relation("Reviewer", fields: [reviewedById], references: [id])

  @@index([requestedById], map: "approval_requests_requested_by_id_fkey")
  @@index([reviewedById], map: "approval_requests_reviewed_by_id_fkey")
  @@map("approval_requests")
}

model RouteAgent {
  id         String   @id @default(cuid())
  routeId    String   @map("route_id")
  agentId    String   @map("agent_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")
  agent      User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, agentId])
  @@index([agentId], map: "route_agents_agent_id_fkey")
  @@map("route_agents")
}

model Vehicle {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  appType         String    @default("autofinance") @map("app_type")
  customerId      String    @map("customer_id")
  registrationNo  String    @map("registration_no")
  make            String
  model           String
  year            Int?
  color           String?
  engineNo        String?   @map("engine_no")
  chassisNo       String?   @map("chassis_no")
  insuranceExpiry DateTime? @map("insurance_expiry") @db.Date
  rcDocPath       String?   @map("rc_doc_path")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  insurancePath   String?   @map("insurance_path")
  loanId          String?   @unique @map("loan_id")
  repoFlag        Boolean   @default(false) @map("repo_flag")
  repoFlaggedAt   DateTime? @map("repo_flagged_at")
  repoFlaggedById String?   @map("repo_flagged_by_id")
  vehicleType     String    @default("two_wheeler") @map("vehicle_type")
  deletedAt       DateTime? @map("deleted_at")
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loan            Loan?     @relation(fields: [loanId], references: [id])
  repoFlaggedBy   User?     @relation("VehicleRepoFlag", fields: [repoFlaggedById], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appType, registrationNo])
  @@index([customerId])
  @@index([repoFlag])
  @@index([repoFlaggedById], map: "vehicles_repo_flagged_by_id_fkey")
  @@map("vehicles")
}

model ChitGroup {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  branchId       String?       @map("branch_id")
  appType        String        @default("chitfunds") @map("app_type")
  name           String
  chitValue      Decimal       @map("chit_value") @db.Decimal(14, 2)
  monthlyContrib Decimal       @map("monthly_contrib") @db.Decimal(14, 2)
  totalMembers   Int           @map("total_members")
  durationMonths Int           @map("duration_months")
  commissionPct  Decimal       @default(5.00) @map("commission_pct") @db.Decimal(5, 2)
  startDate      DateTime      @map("start_date") @db.Date
  status         String        @default("active")
  deletedAt      DateTime?     @map("deleted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  auctions       ChitAuction[]
  branch         Branch?       @relation(fields: [branchId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members        ChitMember[]

  @@index([tenantId, appType, status])
  @@index([branchId], map: "chit_groups_branch_id_fkey")
  @@map("chit_groups")
}

model ChitMember {
  id            String             @id @default(cuid())
  chitGroupId   String             @map("chit_group_id")
  customerId    String             @map("customer_id")
  memberNumber  Int                @map("member_number")
  hasWon        Boolean            @default(false) @map("has_won")
  wonAt         DateTime?          @map("won_at")
  joinedAt      DateTime           @default(now()) @map("joined_at")
  wonAuctions   ChitAuction[]      @relation("AuctionWinner")
  chitGroup     ChitGroup          @relation(fields: [chitGroupId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id])
  subscriptions ChitSubscription[]

  @@unique([chitGroupId, customerId])
  @@unique([chitGroupId, memberNumber])
  @@index([customerId], map: "chit_members_customer_id_fkey")
  @@map("chit_members")
}

model ChitAuction {
  id             String      @id @default(cuid())
  chitGroupId    String      @map("chit_group_id")
  periodNumber   Int         @map("period_number")
  auctionDate    DateTime    @map("auction_date") @db.Date
  winnerMemberId String?     @map("winner_member_id")
  prizeAmount    Decimal?    @map("prize_amount") @db.Decimal(14, 2)
  bidDiscount    Decimal?    @map("bid_discount") @db.Decimal(14, 2)
  commission     Decimal?    @db.Decimal(14, 2)
  dividend       Decimal?    @db.Decimal(14, 2)
  status         String      @default("pending")
  createdAt      DateTime    @default(now()) @map("created_at")
  chitGroup      ChitGroup   @relation(fields: [chitGroupId], references: [id], onDelete: Cascade)
  winnerMember   ChitMember? @relation("AuctionWinner", fields: [winnerMemberId], references: [id])

  @@unique([chitGroupId, periodNumber])
  @@index([winnerMemberId], map: "chit_auctions_winner_member_id_fkey")
  @@map("chit_auctions")
}

model ChitSubscription {
  id           String     @id @default(cuid())
  memberId     String     @map("member_id")
  periodNumber Int        @map("period_number")
  dueDate      DateTime   @map("due_date") @db.Date
  dueAmount    Decimal    @map("due_amount") @db.Decimal(14, 2)
  paidAmount   Decimal    @default(0.00) @map("paid_amount") @db.Decimal(14, 2)
  status       String     @default("upcoming")
  paidAt       DateTime?  @map("paid_at")
  member       ChitMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, periodNumber])
  @@map("chit_subscriptions")
}

model TenantSubscription {
  id               String    @id @default(cuid())
  tenantId         String    @unique @map("tenant_id")
  plan             String    @default("trial")
  status           String    @default("active")
  maxActiveLoans   Int       @default(50) @map("max_active_loans")
  maxAgents        Int       @default(3) @map("max_agents")
  enabledModules   Json      @map("enabled_modules")
  trialEndsAt      DateTime? @map("trial_ends_at")
  currentPeriodEnd DateTime? @map("current_period_end")
  razorpaySubId    String?   @unique @map("razorpay_sub_id")
  gracePeriodEnd   DateTime? @map("grace_period_end")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  tenant           Tenant    @relation(fields: [tenantId], references: [id])

  @@map("tenant_subscriptions")
}

/// Distributed rate-limit tracking backed by MySQL.
/// Rows are keyed on a composite string (e.g. "login:127.0.0.1:alice")
/// and expire automatically via the cleanup cron job.
model RateLimit {
  id          Int      @id @default(autoincrement())
  /// Composite key, e.g. "login:ip:username" or "route:upload:ip"
  key         String   @unique @map("rate_key") @db.VarChar(512)
  count       Int      @default(1)
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("rate_limits")
}

/// Idempotency log for incoming webhooks — prevents duplicate processing.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String // e.g. "razorpay"
  eventId     String   @map("event_id") @db.VarChar(255)
  event       String   @db.VarChar(128)
  payload     String   @db.Text
  status      String   @default("processed") @db.VarChar(32)
  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId], name: "provider_eventId")
  @@index([createdAt])
  @@map("webhook_events")
}

model Payment {
  id              String              @id @default(cuid())
  tenantId        String              @map("tenant_id")
  loanId          String              @map("loan_id")
  amount          Decimal             @db.Decimal(12, 2)
  paymentMode     String              @map("payment_mode")
  referenceNumber String?             @map("reference_number")
  paymentDate     DateTime            @map("payment_date")
  status          String              @default("completed")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  loan            Loan                @relation(fields: [loanId], references: [id])
  allocations     PaymentAllocation[]

  @@index([loanId])
  @@index([tenantId])
  @@map("payments")
}

model PaymentAllocation {
  id           String     @id @default(cuid())
  paymentId    String     @map("payment_id")
  instalmentId String     @map("instalment_id")
  amount       Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  instalment   Instalment @relation(fields: [instalmentId], references: [id])

  @@index([paymentId])
  @@index([instalmentId])
  @@map("payment_allocations")
}

model BillingInvoice {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  subscriptionId String?   @map("subscription_id")
  amount        Decimal   @db.Decimal(12, 2)
  tax           Decimal   @default(0.00) @db.Decimal(12, 2)
  total         Decimal   @default(0.00) @db.Decimal(12, 2)
  status        String    @default("pending")
  dueDate       DateTime  @map("due_date")
  paidAt        DateTime? @map("paid_at")
  razorpayId    String?   @map("razorpay_id")
  invoiceUrl    String?   @map("invoice_url")
  billingPeriod String    @map("billing_period")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("billing_invoices")
}

model CronLock {
  id        String   @id @default("penalty_accrual")
  lockedAt  DateTime @map("locked_at")
  expiresAt DateTime @map("expires_at")

  @@map("cron_locks")
}
