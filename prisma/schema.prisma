  bureauEnabled      Boolean   @default(false) @map("bureau_enabled")
  bureauPullsIncluded Int       @default(50) @map("bureau_pulls_included")
  bureauPullsUsed     Int       @default(0) @map("bureau_pulls_used")
  npaEnabled          Boolean   @default(false) @map("npa_enabled")
  foreclosureEnabled  Boolean   @default(false) @map("foreclosure_enabled")
  kycEnabled          Boolean   @default(false) @map("kyc_enabled")
  trialEndsAt      DateTime? @map("trial_ends_at")

  currentPeriodEnd DateTime? @map("current_period_end")
  razorpaySubId    String?   @unique @map("razorpay_sub_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  gracePeriodEnd   DateTime? @map("grace_period_end")
  tenant           Tenant    @relation(fields: [tenantId], references: [id])

  @@map("tenant_subscriptions")
