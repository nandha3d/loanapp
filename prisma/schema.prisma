  updatedAt     DateTime  @updatedAt @map("updated_at")

  requestedBy User   @relation("ModuleRequestsMade", fields: [requestedById], references: [id])
  reviewedBy  User?  @relation("ModuleRequestsReviewed", fields: [reviewedById], references: [id])
