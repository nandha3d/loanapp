generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String                 @default("LoanTrack")
  slug                  String                 @unique @default("default")
  status                String                 @default("active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  settings              AppSetting[]
  auditLogs             AuditLog[]
  billingInvoices       BillingInvoice[]
  branchRequests        BranchRequest[]
  branches              Branch[]
  chitGroups            ChitGroup[]
  collectionEntries     CollectionEntry[]
  customers             Customer[]
  collections           DailyCollection[]
  loanPackages          LoanPackage[]
  loans                 Loan[]
  moduleRequests        ModuleRequest[]
  notificationTemplates NotificationTemplate[]
  routes                Route[]
  notifications         SystemNotification[]
  subscription          TenantSubscription?
  users                 User[]
  vehicles              Vehicle[]
  accountEntries        AccountEntry[]
  cashHandovers         CashHandover[]
  notificationLogs      NotificationLog[]
  bureauReports         BureauReport[]
  bureauCredential      BureauCredential?
  npaHistory            NpaHistory[]
  loanProvisioning      LoanProvisioning[]
  kycSessions           KycSession[]


  @@map("tenants")
}

model Branch {
  id             String             @id @default(cuid())
  tenantId       String             @map("tenant_id")
  name           String
  code           String?
  address        String?            @db.Text
  phone          String?
  status         String             @default("active")
  deletedAt      DateTime?          @map("deleted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  superadminId   String?            @map("superadmin_id")
  enabledModules String             @default(dbgenerated("(json_array())")) @map("enabled_modules") @db.LongText
  branchRequests        BranchRequest[]
  superadmin            User?              @relation("SuperadminBranches", fields: [superadminId], references: [id])
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  superadminBranchLinks SuperadminBranch[]
  chitGroups     ChitGroup[]
  customers      Customer[]
  collections    DailyCollection[]
  loans          Loan[]
  routes         Route[]
  userModules    UserBranchModule[]
  users          User[]
  accountEntries AccountEntry[]

  @@unique([tenantId, code])
  @@index([superadminId], map: "branches_superadmin_id_fkey")
  @@map("branches")
}

model AppSetting {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  key       String
  value     String   @db.Text
  group     String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("app_settings")
}

model User {
  id                       String             @id @default(cuid())
  tenantId                 String             @map("tenant_id")
  branchId                 String?            @map("branch_id")
  name                     String
  phone                    String
  email                    String?
  username                 String
  passwordHash             String             @map("password_hash")
  role                     String             @default("agent")
  appType                  String             @default("microlending") @map("app_type")
  status                   String             @default("active")
  avatar                   String?
  canCreateLoan            Boolean            @default(false) @map("can_create_loan")
  lastLoginAt              DateTime?          @map("last_login_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  deletedAt                DateTime?          @map("deleted_at")
  totpSecret               String?            @map("totp_secret")
  approvalRequestsMade       ApprovalRequest[]  @relation("Requester")
  approvalRequestsReviewed   ApprovalRequest[]  @relation("Reviewer")
  auditLogs                  AuditLog[]
  branchRequestsMade         BranchRequest[]    @relation("BranchRequestsMade")
  branchRequestsReviewed     BranchRequest[]    @relation("BranchRequestsReviewed")
  superadminBranches         Branch[]           @relation("SuperadminBranches")
  superadminBranchLinks      SuperadminBranch[] @relation("SuperadminBranchLinks")
  superadminBranchAssigned   SuperadminBranch[] @relation("SuperadminBranchAssigner")
  userModules                UserModule[]       @relation("UserModuleUser")
  userModuleAssigned         UserModule[]       @relation("UserModuleAssigner")
  moduleRequestsMade         ModuleRequest[]    @relation("ModuleRequestsMade")
  moduleRequestsReviewed     ModuleRequest[]    @relation("ModuleRequestsReviewed")
  collectionEntries        CollectionEntry[]
  assignedCustomers        Customer[]         @relation("AgentCustomers")
  dailyCollections         DailyCollection[]
  createdLoans             Loan[]             @relation("LoanCreator")
  foreclosedLoans           Loan[]             @relation("LoanForecloser")
  settledPenalties         Penalty[]          @relation("PenaltySettler")
  routeAgents              RouteAgent[]
  assignedRoutes           Route[]
  userBranchModules        UserBranchModule[]
  kycVerifications         Customer[]         @relation("KycVerifier")
  kycSessionsInitiated     KycSession[]       @relation("KycSessionInitiator")
  kycSessionsReviewed      KycSession[]       @relation("KycSessionReviewer")
  branch                   Branch?            @relation(fields: [branchId], references: [id])
  tenant                   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  vehicleRepoFlags         Vehicle[]          @relation("VehicleRepoFlag")
  accountEntries           AccountEntry[]
  agentHandovers           CashHandover[]     @relation("AgentHandovers")
  adminHandovers           CashHandover[]     @relation("AdminHandovers")

  @@unique([tenantId, username])
  @@unique([tenantId, phone])
  @@index([branchId], map: "users_branch_id_fkey")
  @@map("users")
}

model BranchRequest {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  requestedById    String    @map("requested_by_id")
  branchId         String?   @map("branch_id")
  branchName       String?   @map("branch_name")
  requestedModules String    @map("requested_modules") @db.LongText
  reason           String?   @db.Text
  status           String    @default("pending")
  reviewedById     String?   @map("reviewed_by_id")
  reviewNote       String?   @map("review_note") @db.Text
  reviewedAt       DateTime? @map("reviewed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  branch           Branch?   @relation(fields: [branchId], references: [id])
  requestedBy      User      @relation("BranchRequestsMade", fields: [requestedById], references: [id])
  reviewedBy       User?     @relation("BranchRequestsReviewed", fields: [reviewedById], references: [id])
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([branchId], map: "branch_requests_branchId_idx")
  @@index([requestedById], map: "branch_requests_requestedById_idx")
  @@index([reviewedById], map: "branch_requests_reviewed_by_id_fkey")
  @@index([tenantId], map: "branch_requests_tenantId_idx")
  @@map("branch_requests")
}

model UserBranchModule {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  branchId       String   @map("branch_id")
  enabledModules String   @map("enabled_modules") @db.LongText
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId], map: "user_branch_modules_branchId_idx")
  @@map("user_branch_modules")
}

model Route {
  id               String            @id @default(cuid())
  tenantId         String            @map("tenant_id")
  branchId         String?           @map("branch_id")
  name             String
  assignedAgentId  String?           @map("assigned_agent_id")
  status           String            @default("active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  appType          String            @default("microlending") @map("app_type")
  customers        Customer[]
  dailyCollections DailyCollection[]
  routeAgents      RouteAgent[]
  assignedAgent    User?             @relation(fields: [assignedAgentId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashHandovers    CashHandover[]

  @@index([assignedAgentId], map: "routes_assigned_agent_id_fkey")
  @@index([branchId], map: "routes_branch_id_fkey")
  @@index([tenantId], map: "routes_tenant_id_fkey")
  @@map("routes")
}

model Customer {
  id                String            @id @default(cuid())
  tenantId          String            @map("tenant_id")
  branchId          String?           @map("branch_id")
  customerCode      String            @map("customer_code")
  name              String
  phone             String
  address           String?           @db.Text
  aadharNumber      String?           @map("aadhar_number")
  routeId           String?           @map("route_id")
  agentId           String?           @map("agent_id")
  kycStatus         String            @default("pending")
  kycMethod         String?           @map("kyc_method") // 'manual_upload' | 'aadhaar_otp' | 'video_kyc'
  kycVerifiedAt     DateTime?         @map("kyc_verified_at")
  kycVerifiedById   String?           @map("kyc_verified_by_id")
  kycRejectedReason String?           @map("kyc_rejected_reason") @db.Text

  // Aadhaar OTP fields (populated by UIDAI response via Digio)
  aadhaarVerified   Boolean           @default(false) @map("aadhaar_verified")
  aadhaarName       String?           @map("aadhaar_name")
  aadhaarDob        String?           @map("aadhaar_dob")
  aadhaarAddress    String?           @map("aadhaar_address") @db.Text
  aadhaarPhoto      String?           @map("aadhaar_photo")    // path to stored photo from UIDAI

  kycVerifiedBy     User?             @relation("KycVerifier", fields: [kycVerifiedById], references: [id])
  kycSessions       KycSession[]
  profilePhoto      String?           @map("profile_photo")
  userId            String?           @unique @map("user_id")

  passwordHash      String?           @map("password_hash")
  status            String            @default("active")
  notes             String?           @db.Text
  appType           String            @default("microlending") @map("app_type")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")
  pan               String?           @map("pan")
  // GPS-01 / GPS-07: geocoded home location for geofence + route planning.
  lat               Float?            @map("lat")
  lng               Float?            @map("lng")
  geocodedAt        DateTime?         @map("geocoded_at")
  chitGroupMembers  ChitMember[]
  collectionEntries CollectionEntry[]
  agent             User?             @relation("AgentCustomers", fields: [agentId], references: [id])
  branch            Branch?           @relation(fields: [branchId], references: [id])
  route             Route?            @relation(fields: [routeId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guarantors        Guarantor[]
  kycDocuments      KycDocument[]
  loans             Loan[]
  penalties         Penalty[]
  securityCheques   SecurityCheque[]
  vehicles          Vehicle[]
  bureauReports     BureauReport[]

  @@unique([tenantId, customerCode])
  // ⚡ Bolt: Added composite index on tenantId, appType, and status to optimize frequent list queries across the app
  @@index([tenantId, appType, status])
  @@index([agentId], map: "customers_agent_id_fkey")
  @@index([branchId], map: "customers_branch_id_fkey")
  @@index([routeId], map: "customers_route_id_fkey")
  @@index([phone])
  @@map("customers")
}

model KycDocument {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  docType    String   @map("doc_type")
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  fileSize   Int?     @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "kyc_documents_customer_id_fkey")
  @@map("kyc_documents")
}

model SecurityCheque {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  bankName     String   @map("bank_name")
  chequeNumber String   @map("cheque_number")
  amount       Decimal? @db.Decimal(12, 2)
  imagePath    String?  @map("image_path")
  status       String   @default("active")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  loanId       String?  @map("loan_id")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loan         Loan?    @relation(fields: [loanId], references: [id])

  @@index([customerId], map: "security_cheques_customer_id_fkey")
  @@index([loanId], map: "security_cheques_loan_id_fkey")
  @@map("security_cheques")
}

model LoanPackage {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  name          String
  principal     Decimal  @db.Decimal(12, 2)
  deduction     Decimal  @db.Decimal(12, 2)
  frequency     String
  tenure        Int
  perInstalment Decimal  @map("per_instalment") @db.Decimal(12, 2)
  penaltyRate   Decimal  @map("penalty_rate") @db.Decimal(12, 2)
  appType       String   @default("microlending") @map("app_type")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deductionType String   @default("fixed") @map("deduction_type")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans         Loan[]

  @@index([tenantId], map: "loan_packages_tenant_id_fkey")
  @@map("loan_packages")
}

model Loan {
  id                String            @id @default(cuid())
  tenantId          String            @map("tenant_id")
  branchId          String?           @map("branch_id")
  loanCode          String            @map("loan_code")
  customerId        String            @map("customer_id")
  packageId         String?           @map("package_id")
  loanType          String            @default("cheque") @map("loan_type")
  appType           String            @default("microlending") @map("app_type")
  collateralDetails String?           @map("collateral_details") @db.Text
  guarantorId       String?           @map("guarantor_id")
  principal         Decimal           @db.Decimal(12, 2)
  deduction         Decimal           @db.Decimal(12, 2)
  disbursed         Decimal           @db.Decimal(12, 2)
  frequency         String
  dueDay            Int?              @map("due_day")
  tenure            Int
  startDate         DateTime          @map("start_date") @db.Date
  endDate           DateTime?         @map("end_date") @db.Date
  perInstalment     Decimal           @map("per_instalment") @db.Decimal(12, 2)
  penaltyRate       Decimal           @map("penalty_rate") @db.Decimal(12, 2)
  voucherRef        String?           @map("voucher_ref")
  status            String            @default("active")
  paidCount         Int               @default(0) @map("paid_count")
  totalInstalments  Int               @map("total_instalments")
  totalCollected    Decimal           @default(0.00) @map("total_collected") @db.Decimal(12, 2)
  closedAt          DateTime?         @map("closed_at")
  closureType       String?           @map("closure_type")
  foreclosureAmount Decimal?          @map("foreclosure_amount") @db.Decimal(12, 2)
  foreclosureDiscount Decimal?        @map("foreclosure_discount") @db.Decimal(12, 2)
  foreclosureById   String?           @map("foreclosure_by_id")
  createdById       String?           @map("created_by_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deductionType     String            @default("fixed") @map("deduction_type")
  deletedAt         DateTime?         @map("deleted_at")
  npaClassifiedAt      DateTime?         @map("npa_classified_at")
  npaStatus            String?           @map("npa_status")
  npaSubCategory       String?           @map("npa_sub_category")
  npaDaysOverdue       Int               @default(0) @map("npa_days_overdue")
  npaUpgradeEligible   Boolean           @default(false) @map("npa_upgrade_eligible")
  lastNpaReviewDate    DateTime?         @map("last_npa_review_date")
  provisioningRate     Decimal           @default(0) @map("provisioning_rate") @db.Decimal(6, 2)
  provisioningAmount   Decimal           @default(0) @map("provisioning_amount") @db.Decimal(12, 2)
  provisioningCategory String            @default("standard") @map("provisioning_category")
  isSecured            Boolean           @default(false) @map("is_secured")
  totalPayable      Decimal           @default(0.00) @map("total_payable") @db.Decimal(12, 2)
  collectionEntries CollectionEntry[]
  instalments       Instalment[]
  collaterals       LoanCollateral[]
  branch            Branch?           @relation(fields: [branchId], references: [id])
  createdBy         User?             @relation("LoanCreator", fields: [createdById], references: [id])
  foreclosedBy      User?             @relation("LoanForecloser", fields: [foreclosureById], references: [id])
  customer          Customer          @relation(fields: [customerId], references: [id])
  guarantor         Guarantor?        @relation(fields: [guarantorId], references: [id])
  package           LoanPackage?      @relation(fields: [packageId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments          Payment[]
  penalties         Penalty[]
  securityCheques   SecurityCheque[]
  vehicle           Vehicle?
  bureauReportId    String?           @map("bureau_report_id")
  bureauReport      BureauReport?     @relation("LoanBureauReport", fields: [bureauReportId], references: [id])
  npaHistory        NpaHistory[]
  loanProvisioning  LoanProvisioning[]

  @@unique([tenantId, loanCode])
  // ⚡ Bolt: Added composite index on tenantId, appType, and status to optimize active loan queries and dashboard aggregations
  @@index([tenantId, appType, status])
  @@index([branchId], map: "loans_branch_id_fkey")
  @@index([createdById], map: "loans_created_by_id_fkey")
  @@index([foreclosureById], map: "loans_foreclosure_by_id_fkey")
  @@index([customerId], map: "loans_customer_id_fkey")
  @@index([guarantorId], map: "loans_guarantor_id_fkey")
  @@index([packageId], map: "loans_package_id_fkey")
  @@index([tenantId, npaStatus])
  @@index([tenantId, npaDaysOverdue])
  @@map("loans")
}

model Instalment {
  id                 String              @id @default(cuid())
  loanId             String              @map("loan_id")
  instalmentNo       Int                 @map("instalment_no")
  dueDate            DateTime            @map("due_date") @db.Date
  dueAmount          Decimal             @map("due_amount") @db.Decimal(12, 2)
  receivedAmount     Decimal             @default(0.00) @map("received_amount") @db.Decimal(12, 2)
  paymentMode        String?             @map("payment_mode")
  status             String              @default("upcoming")
  receivedAt         DateTime?           @map("received_at")
  agentId            String?             @map("agent_id")
  remarks            String?             @db.Text
  lockedAt           DateTime?           @map("locked_at")
  penaltyApplied     Boolean             @default(false) @map("penalty_applied")
  collectionEntryId  String?             @unique @map("collection_entry_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  collectionEntry    CollectionEntry?    @relation(fields: [collectionEntryId], references: [id])
  loan               Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paymentAllocations PaymentAllocation[]
  penalties          Penalty[]
  bureauReportId    String?           @map("bureau_report_id")
  bureauReport      BureauReport?     @relation("InstalmentBureauReport", fields: [bureauReportId], references: [id])

  @@unique([loanId, instalmentNo])
  // ⚡ Bolt: Added composite index on loanId, dueDate, and status to optimize instalment lookups for specific loans, speeding up collection pages
  @@index([loanId, dueDate, status])
  @@index([dueDate])
  @@index([status])
  @@map("instalments")
}

model Penalty {
  id            String      @id @default(cuid())
  loanId        String      @map("loan_id")
  customerId    String      @map("customer_id")
  missedDays    Int         @default(0) @map("missed_days")
  grossPenalty  Decimal     @default(0.00) @map("gross_penalty") @db.Decimal(12, 2)
  settledAmount Decimal     @default(0.00) @map("settled_amount") @db.Decimal(12, 2)
  waivedAmount  Decimal     @default(0.00) @map("waived_amount") @db.Decimal(12, 2)
  status        String      @default("pending")
  settledById   String?     @map("settled_by_id")
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  settledAt     DateTime?   @map("settled_at")
  instalmentId  String?     @map("instalment_id")
  customer      Customer    @relation(fields: [customerId], references: [id])
  instalment    Instalment? @relation(fields: [instalmentId], references: [id])
  loan          Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  settledBy     User?       @relation("PenaltySettler", fields: [settledById], references: [id])

  @@index([customerId], map: "penalties_customer_id_fkey")
  @@index([loanId], map: "penalties_loan_id_fkey")
  @@index([settledById], map: "penalties_settled_by_id_fkey")
  @@index([instalmentId], map: "penalties_instalment_id_fkey")
  @@map("penalties")
}

model DailyCollection {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  branchId       String?           @map("branch_id")
  agentId        String            @map("agent_id")
  routeId        String?           @map("route_id")
  date           DateTime          @db.Date
  totalExpected  Decimal           @default(0.00) @map("total_expected") @db.Decimal(12, 2)
  totalCollected Decimal           @default(0.00) @map("total_collected") @db.Decimal(12, 2)
  entriesCount   Int               @default(0) @map("entries_count")
  appType        String            @default("microlending") @map("app_type")
  status         String            @default("open")
  lockedAt       DateTime?         @map("locked_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  entries        CollectionEntry[]
  agent          User              @relation(fields: [agentId], references: [id])
  branch         Branch?           @relation(fields: [branchId], references: [id])
  route          Route?            @relation(fields: [routeId], references: [id])
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appType, agentId, date])
  @@index([date])
  @@index([branchId], map: "daily_collections_branch_id_fkey")
  @@index([routeId], map: "daily_collections_route_id_fkey")
  @@index([tenantId], map: "daily_collections_tenant_id_fkey")
  @@index([agentId])
  @@map("daily_collections")
}

model CollectionEntry {
  id             String          @id @default(cuid())
  collectionId   String          @map("collection_id")
  customerId     String          @map("customer_id")
  loanId         String          @map("loan_id")
  dueAmount      Decimal         @map("due_amount") @db.Decimal(12, 2)
  receivedAmount Decimal         @map("received_amount") @db.Decimal(12, 2)
  paymentMode    String          @default("cash") @map("payment_mode")
  remarks        String?         @db.Text
  agentId        String          @map("agent_id")
  submittedAt    DateTime        @default(now()) @map("submitted_at")
  isLocked       Boolean         @default(true) @map("is_locked")
  verificationStatus String      @default("pending") @map("verification_status")
  tenantId       String?         @map("tenant_id")
  idempotencyKey String?         @unique @map("idempotency_key")
  // GPS-01: location of agent at collection time. Nullable for back-compat.
  lat            Float?          @map("lat")
  lng            Float?          @map("lng")
  gpsAccuracyM   Float?          @map("gps_accuracy_m")
  gpsCapturedAt  DateTime?       @map("gps_captured_at")
  distanceFromCustomerM Float?   @map("distance_from_customer_m")
  agent          User            @relation(fields: [agentId], references: [id])
  collection     DailyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id])
  loan           Loan            @relation(fields: [loanId], references: [id])
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instalment     Instalment?

  @@index([agentId], map: "collection_entries_agent_id_fkey")
  @@index([collectionId], map: "collection_entries_collection_id_fkey")
  @@index([customerId], map: "collection_entries_customer_id_fkey")
  @@index([loanId], map: "collection_entries_loan_id_fkey")
  @@index([tenantId])
  @@index([submittedAt])
  @@map("collection_entries")
}

model SystemNotification {
