model ChitAuctionAttendance {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  branchId   String?     @map("branch_id")
  auctionId  String      @map("auction_id")
  memberId   String      @map("member_id")
  status     String      @default("present")
  // Live-room admission state (attendance doubles as presence): waiting until
  // the organizer decides when the group is 'approval'; else auto 'admitted'.
  admissionStatus String  @default("admitted") @map("admission_status")
  proxyName  String?     @map("proxy_name")
  remarks    String?     @db.Text
  markedById String?     @map("marked_by_id")
  markedAt   DateTime    @default(now()) @map("marked_at")
  // How this row was created: 'staff' (manual), 'room_join' (opened the live
  // room), 'login' (any borrower-portal login on auction day), 'whatsapp'
  // (doc 23). Existing pre-feature rows default to 'staff' since manual
  // marking was the only path before this.
  markedVia  String      @default("staff") @map("marked_via")
  auction    ChitAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  member     ChitMember  @relation(fields: [memberId], references: [id])

  @@unique([auctionId, memberId])
  @@index([tenantId, branchId])
  @@index([memberId])
  @@map("chit_auction_attendance")
}

// Live-room chat. 'public' messages are visible to everyone in the room;
// 'organizer' messages are private between the sender and staff. senderName is
// denormalized so the hot poll can render without joins.
model ChitRoomMessage {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  auctionId      String   @map("auction_id")
  senderUserId   String?  @map("sender_user_id") // staff/organizer sender
  senderMemberId String?  @map("sender_member_id") // subscriber sender (M3)
  senderName     String   @map("sender_name")
  visibility     String   @default("public") // public | organizer
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  auction ChitAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
  @@map("chit_room_messages")
}

// Customer-filed "I've paid" claim awaiting staff review before any money
