  enabledModules           String    @map("enabled_modules") @db.LongText
  whatsappSmsEnabled       Boolean   @default(false) @map("whatsapp_sms_enabled")
  receiptPdfAllowed        Boolean   @default(false) @map("receipt_pdf_allowed")
  bureauEnabled            Boolean   @default(false) @map("bureau_enabled")
  bureauPullsIncluded      Int       @default(50) @map("bureau_pulls_included")
  bureauPullsUsed          Int       @default(0) @map("bureau_pulls_used")
