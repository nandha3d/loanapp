// GPS-02: ordered customer stops per route, with location.
// Phase 3 will use this for nearest-neighbor route optimization.
model RouteStop {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  routeId     String   @map("route_id")
  customerId  String   @map("customer_id")
  sequence    Int      @default(0)
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([routeId, customerId])
  @@index([tenantId])
  @@index([routeId, sequence])
  @@map("route_stops")
}

// GPS-03: agent location pings (live tracking + history).
// Phase 3 will populate from POST /api/v1/gps/ping every 30s during
// active collection sessions.
model AgentLocationPing {
  id           String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  agentId     String   @map("agent_id")
  routeId     String?  @map("route_id")
  lat         Float
  lng         Float
  accuracyM   Float?   @map("accuracy_m")
  speedMps    Float?   @map("speed_mps")
  capturedAt  DateTime @map("captured_at")
  receivedAt  DateTime @default(now()) @map("received_at")

  @@index([tenantId, agentId, capturedAt])
  @@index([routeId, capturedAt])
  @@map("agent_location_pings")
}

/// Developer-assigned mapping of which branches a superadmin manages.
