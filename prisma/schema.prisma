// ── Payment Proof (Photo / QR) ───────────────────────────────────────────────
// Standalone tables (scalar FK ids, no Prisma relations) so adding them needs
// no back-relation edits on existing models. See docs/payment-proof-plan.md.

model PaymentApproval {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  branchId          String?   @map("branch_id")
  loanId            String    @map("loan_id")
  instalmentId      String    @map("instalment_id")
  customerId        String    @map("customer_id")
  agentId           String    @map("agent_id")
  amount            Decimal   @db.Decimal(12, 2)
  paymentMode       String    @default("cash") @map("payment_mode")
  proofType         String    @default("photo") @map("proof_type") // 'photo'
  photoPath         String?   @map("photo_path")
  status            String    @default("pending") // pending | approved | rejected | expired
  rejectedReason    String?   @map("rejected_reason") @db.Text
  collectionEntryId String?   @map("collection_entry_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  respondedAt       DateTime? @map("responded_at")

  @@index([tenantId, status])
  @@index([customerId, status])
  @@map("payment_approvals")
}

model ClientPaymentToken {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  customerId        String    @map("customer_id")
  loanId            String    @map("loan_id")
  instalmentId      String    @map("instalment_id")
  amount            Decimal   @db.Decimal(12, 2)
  token             String    @unique
  status            String    @default("active") // active | used | expired | paid | failed
  collectionEntryId String?   @map("collection_entry_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")
  usedAt            DateTime? @map("used_at")
  // mCollect-B (digital self-pay). Additive — legacy agent-scan QR tokens leave
  // these null and behave exactly as before.
  channel           String    @default("upi") // upi | card | netbanking | link | qr
  payUrl            String?   @map("pay_url") @db.Text // hosted PSP payable link / UPI intent
  providerRef       String?   @map("provider_ref") // PSP order / payment id
  paidAt            DateTime? @map("paid_at")

  @@index([tenantId, status])
  @@index([providerRef])
  @@map("client_payment_tokens")
}

