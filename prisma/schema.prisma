model CollectionEntry {
  id                     String          @id @default(cuid())
  collectionId           String          @map("collection_id")
  customerId             String          @map("customer_id")
  loanId                 String          @map("loan_id")
  dueAmount              Decimal         @map("due_amount") @db.Decimal(12, 2)
  receivedAmount         Decimal         @map("received_amount") @db.Decimal(12, 2)
  paymentMode            String          @default("cash") @map("payment_mode")
  remarks                String?         @db.Text
  agentId                String          @map("agent_id")
  submittedAt            DateTime        @default(now()) @map("submitted_at")
  isLocked               Boolean         @default(true) @map("is_locked")
  verificationStatus     String          @default("pending") @map("verification_status")
  tenantId               String?         @map("tenant_id")
  idempotencyKey         String?         @unique @map("idempotency_key")
  // GPS-01: location of agent at collection time. Nullable for back-compat.
  lat                    Float?          @map("lat")
  lng                    Float?          @map("lng")
  gpsAccuracyM           Float?          @map("gps_accuracy_m")
  gpsCapturedAt          DateTime?       @map("gps_captured_at")
  distanceFromCustomerM  Float?          @map("distance_from_customer_m")
  // Additional verification metadata (from collection-tracking module)
  gpsAltitude            Float?          @map("gps_altitude")
  locationStatus         String          @default("not_captured") @map("location_status")
  borrowerLat            Float?          @map("borrower_lat")
  borrowerLng            Float?          @map("borrower_lng")
  // Fraud-01: customer PIN confirmation at time of cash collection
  customerPinConfirmed   Boolean         @default(false) @map("customer_pin_confirmed")
  customerPinConfirmedAt DateTime?       @map("customer_pin_confirmed_at")
  // mCollect: stream tag (field | route_run | self_pay_upi) + batch run linkage.
  // Additive — existing rows default to 'field', so legacy behaviour is unchanged.
  source                 String          @default("field")
  runId                  String?         @map("run_id")
  agent                  User            @relation(fields: [agentId], references: [id])
  collection             DailyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  customer               Customer        @relation(fields: [customerId], references: [id])
  loan                   Loan            @relation(fields: [loanId], references: [id])
  tenant                 Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instalment             Instalment?
  // NOTE: relations below were committed in 896c7d1 without their model
  // definitions, which broke `prisma generate`/`validate`. Commented out
  // until the CollectionPhoto / ReceiptToken models are actually defined.
  // photos         CollectionPhoto[]
  // receiptToken   ReceiptToken?

  @@index([agentId], map: "collection_entries_agent_id_fkey")
  @@index([collectionId], map: "collection_entries_collection_id_fkey")
  @@index([customerId], map: "collection_entries_customer_id_fkey")
  @@index([loanId], map: "collection_entries_loan_id_fkey")
  @@index([tenantId])
  @@index([submittedAt])
  @@index([tenantId, locationStatus])
  @@index([runId])
  @@index([tenantId, source])
  @@map("collection_entries")
}

