  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  requestedBy User    @relation("ModuleRequestsMade", fields: [requestedById], references: [id])
  reviewedBy  User?   @relation("ModuleRequestsReviewed", fields: [reviewedById], references: [id])
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([requestedById])
  @@map("module_requests")
}

