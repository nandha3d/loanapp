}

// ── Gold/Silver master data — the no-hardcode source for pledge dropdowns ──────
// Per-tenant, admin-editable. Ornament types/specs and bank names are NEVER
// hardcoded in the UI; the pledge form reads these via /api/v1/gold/master.

model OrnamentType {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  metal     String   @default("gold") // gold | silver
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, metal, isActive])
  @@map("ornament_types")
}

model OrnamentSpecification {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  purityKarat String?  @map("purity_karat")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("ornament_specifications")
}

model BankName {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("bank_names")
}

model ApprovalRequest {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  appType          String    @map("app_type")
  requestType      String    @map("request_type")
  entityType       String    @map("entity_type")
  entityId         String    @map("entity_id")
  requestedById    String    @map("requested_by_id")
  requestedChanges String    @map("requested_changes") @db.Text
  reason           String?   @db.Text
  status           String    @default("pending")
  reviewedById     String?   @map("reviewed_by_id")
  reviewedAt       DateTime? @map("reviewed_at")
  reviewNotes      String?   @map("review_notes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  requestedBy      User      @relation("Requester", fields: [requestedById], references: [id])
  reviewedBy       User?     @relation("Reviewer", fields: [reviewedById], references: [id])

  @@index([requestedById], map: "approval_requests_requested_by_id_fkey")
  @@index([reviewedById], map: "approval_requests_reviewed_by_id_fkey")
  @@map("approval_requests")
}

model RouteAgent {
  id         String   @id @default(cuid())
  routeId    String   @map("route_id")
  agentId    String   @map("agent_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")
  agent      User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, agentId])
  @@index([agentId], map: "route_agents_agent_id_fkey")
  @@map("route_agents")
}

model Vehicle {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  appType         String    @default("autofinance") @map("app_type")
  customerId      String    @map("customer_id")
  registrationNo  String    @map("registration_no")
  make            String
  model           String
  year            Int?
  color           String?
  engineNo        String?   @map("engine_no")
  chassisNo       String?   @map("chassis_no")
  insuranceExpiry DateTime? @map("insurance_expiry") @db.Date
  rcDocPath       String?   @map("rc_doc_path")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  insurancePath   String?   @map("insurance_path")
  loanId          String?   @unique @map("loan_id")
  repoFlag        Boolean   @default(false) @map("repo_flag")
  repoFlaggedAt   DateTime? @map("repo_flagged_at")
  repoFlaggedById String?   @map("repo_flagged_by_id")
  vehicleType     String    @default("two_wheeler") @map("vehicle_type")
  deletedAt       DateTime? @map("deleted_at")
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loan            Loan?     @relation(fields: [loanId], references: [id])
  repoFlaggedBy   User?     @relation("VehicleRepoFlag", fields: [repoFlaggedById], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recoveries      VehicleRecovery[]
  photos          VehiclePhoto[]

  @@unique([tenantId, appType, registrationNo])
  @@index([customerId])
  @@index([repoFlag])
  @@index([repoFlaggedById], map: "vehicles_repo_flagged_by_id_fkey")
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Auto Finance (Hire Purchase) — origination, recovery and daily operations.
// All models are tenant + appType scoped like the rest of the module tables.
// ---------------------------------------------------------------------------

/// Brokers and dealers who source HP business. One table with a `type`
/// discriminator so the origination wizard can fill both dropdowns in a query.
model FinancePartner {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  branchId       String?   @map("branch_id")
  appType        String    @default("autofinance") @map("app_type")
  /// 'broker' | 'dealer'
  type           String
  name           String
  phone          String?
  address        String?   @db.Text
  /// Default commission %, overridable per loan in the origination wizard.
  commissionRate Decimal?  @map("commission_rate") @db.Decimal(6, 2)
  notes          String?   @db.Text
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch? @relation(fields: [branchId], references: [id])
  brokerLoans  Loan[]  @relation("LoanBroker")
  dealerLoans  Loan[]  @relation("LoanDealer")

  @@unique([tenantId, appType, type, name])
  @@index([tenantId, appType, type, status])
  @@index([branchId], map: "finance_partners_branch_id_fkey")
  @@map("finance_partners")
}

/// HP-specific financial configuration for a loan. 1:1 with Loan, mirroring
/// GoldLoanCollateral / PropertyCollateral / ProductFinanceItem so the shared
/// Loan table does not grow a column per module.
model AutoFinanceDetail {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  loanId   String @unique @map("loan_id")

  // Step 2 — financial configuration
  vehicleValue   Decimal? @map("vehicle_value") @db.Decimal(14, 2)
  downPayment    Decimal? @map("down_payment") @db.Decimal(14, 2)
  /// 'flat' | 'diminishing'
  interestMethod String   @default("flat") @map("interest_method")
  interestRate   Decimal? @map("interest_rate") @db.Decimal(6, 2)
  /// Whether the computed EMI was rounded to the nearest rupee on origination.
  roundOffEmi    Boolean  @default(false) @map("round_off_emi")

  // Step 3 — charges, penalties and payouts
  gracePeriodDays  Int      @default(0) @map("grace_period_days")
  penaltyPerDay    Decimal  @default(0.00) @map("penalty_per_day") @db.Decimal(12, 2)
  /// Insurance / RTO money advanced on top of the vehicle finance.
  handLoanAmount   Decimal  @default(0.00) @map("hand_loan_amount") @db.Decimal(12, 2)
  insuranceCharge  Decimal  @default(0.00) @map("insurance_charge") @db.Decimal(12, 2)
  documentCharge   Decimal  @default(0.00) @map("document_charge") @db.Decimal(12, 2)
  brokerCommission Decimal  @default(0.00) @map("broker_commission") @db.Decimal(12, 2)

  // Disbursement payment splitter (up to two modes)
  payoutMode1   String?  @map("payout_mode_1")
  payoutAmount1 Decimal? @map("payout_amount_1") @db.Decimal(12, 2)
  payoutMode2   String?  @map("payout_mode_2")
  payoutAmount2 Decimal? @map("payout_amount_2") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("auto_finance_details")
}

/// A seizure episode for a financed vehicle. Replaces the flat `repoFlag`
/// boolean with an auditable yard/charges/release trail. A vehicle may be
/// seized and released more than once, so this is a history table.
model VehicleRecovery {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  vehicleId      String    @map("vehicle_id")
  loanId         String    @map("loan_id")
  seizedAt       DateTime  @map("seized_at")
  seizedById     String?   @map("seized_by_id")
  /// Free-text agent/recovery-team name when the seizer is not a system user.
  seizedByName   String?   @map("seized_by_name")
  yardLocation   String    @map("yard_location")
  seizingCharges Decimal   @default(0.00) @map("seizing_charges") @db.Decimal(12, 2)
  remarks        String?   @db.Text
  /// 'seized' | 'released' | 'sold'
  status         String    @default("seized")
  releasedAt     DateTime? @map("released_at")
  releasedById   String?   @map("released_by_id")
  /// Payment that settled the seizing charges when the vehicle was released.
  releasePaymentId String? @map("release_payment_id")
  releaseRemarks   String? @map("release_remarks") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  loan       Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  seizedBy   User?   @relation("VehicleSeizedBy", fields: [seizedById], references: [id])
  releasedBy User?   @relation("VehicleReleasedBy", fields: [releasedById], references: [id])

  @@index([tenantId, status])
  @@index([vehicleId])
  @@index([loanId])
  @@index([seizedById], map: "vehicle_recoveries_seized_by_id_fkey")
  @@index([releasedById], map: "vehicle_recoveries_released_by_id_fkey")
  @@map("vehicle_recoveries")
}

/// Asset photographs for the Customer 360° "Asset Photos" tab.
model VehiclePhoto {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  vehicleId  String   @map("vehicle_id")
  /// 'vehicle' | 'rc' | 'customer' | 'seizure' | 'other'
  kind       String   @default("vehicle")
  path       String
  caption    String?
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId, kind])
  @@map("vehicle_photos")
}

/// End-of-day reconciliation. Staff cannot open the next day's pending list
/// until the previous business day has a closed row.
model DayClosingLog {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  branchId     String?  @map("branch_id")
  appType      String   @default("autofinance") @map("app_type")
  businessDate DateTime @map("business_date") @db.Date

  openingCash    Decimal @default(0.00) @map("opening_cash") @db.Decimal(14, 2)
  collectedCash  Decimal @default(0.00) @map("collected_cash") @db.Decimal(14, 2)
  disbursedCash  Decimal @default(0.00) @map("disbursed_cash") @db.Decimal(14, 2)
  expectedClosing Decimal @default(0.00) @map("expected_closing") @db.Decimal(14, 2)
  /// Cash the closing user actually counted; difference drives the variance.
  countedClosing Decimal @default(0.00) @map("counted_closing") @db.Decimal(14, 2)
  variance       Decimal @default(0.00) @db.Decimal(14, 2)

  receiptCount   Int     @default(0) @map("receipt_count")
  remarks        String? @db.Text
  closedById     String? @map("closed_by_id")
  closedAt       DateTime @default(now()) @map("closed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch? @relation(fields: [branchId], references: [id])
  closedBy User?   @relation("DayClosedBy", fields: [closedById], references: [id])

  @@unique([tenantId, appType, branchId, businessDate])
  @@index([tenantId, appType, businessDate])
  @@index([branchId], map: "day_closing_logs_branch_id_fkey")
  @@index([closedById], map: "day_closing_logs_closed_by_id_fkey")
  @@map("day_closing_logs")
}

/// Call / follow-up log. `promisedDate` powers the "Promised Customers" (PTP)
/// dashboard widget and the mobile remark + next-promise flow.
model CustomerCallLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  appType    String   @default("autofinance") @map("app_type")
  customerId String   @map("customer_id")
  loanId     String?  @map("loan_id")
  /// 'call' | 'visit' | 'whatsapp' | 'sms' | 'note'
  channel    String   @default("call")
  /// 'promised' | 'no_answer' | 'refused' | 'wrong_number' | 'paid' | 'other'
  outcome    String   @default("other")
  remarks    String?  @db.Text
  /// Promise-to-pay date captured from the agent.
  promisedDate   DateTime? @map("promised_date") @db.Date
  promisedAmount Decimal?  @map("promised_amount") @db.Decimal(12, 2)
  /// Set once a payment lands on/after the promise, so the widget can drop it.
  fulfilledAt    DateTime? @map("fulfilled_at")
  loggedById String?  @map("logged_by_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loan     Loan?    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loggedBy User?    @relation("CallLoggedBy", fields: [loggedById], references: [id])

  @@index([tenantId, appType, promisedDate])
  @@index([customerId])
  @@index([loanId])
  @@index([loggedById], map: "customer_call_logs_logged_by_id_fkey")
  @@map("customer_call_logs")
}

model ChitGroup {
  id                      String        @id @default(cuid())
  tenantId                String        @map("tenant_id")
  branchId                String?       @map("branch_id")
  appType                 String        @default("chitfunds") @map("app_type")
  groupCode               String?       @unique @map("group_code")
  name                    String
  chitValue               Decimal       @map("chit_value") @db.Decimal(14, 2)
  monthlyContrib          Decimal       @map("monthly_contrib") @db.Decimal(14, 2)
  totalMembers            Int           @map("total_members")
  durationMonths          Int           @map("duration_months")
  commissionPct           Decimal       @default(5.00) @map("commission_pct") @db.Decimal(5, 2)
  startDate               DateTime      @map("start_date") @db.Date
  status                  String        @default("draft")
  registrationNo          String?       @map("registration_no")
  registrationDate        DateTime?     @map("registration_date") @db.Date
  registrarOffice         String?       @map("registrar_office")
  bylawNo                 String?       @map("bylaw_no")
  commencementCertificate String?       @map("commencement_certificate")
  approvedBankName        String?       @map("approved_bank_name")
  approvedBankAccountNo   String?       @map("approved_bank_account_no")
  foremanName             String?       @map("foreman_name")
  foremanCommissionCapPct Decimal?      @map("foreman_commission_cap_pct") @db.Decimal(5, 2)
  maxDiscountPct          Decimal?      @map("max_discount_pct") @db.Decimal(5, 2)
  auctionFrequency        String        @default("monthly") @map("auction_frequency")
  frequencyUnit           String?       @map("frequency_unit")     // 'day' | 'week' | 'month' — overrides auctionFrequency preset when set
  frequencyInterval       Int?          @map("frequency_interval") // every N units
  frequencyWeekdays       String?       @map("frequency_weekdays") // CSV of 0-6 (Sun-Sat), only for unit='day'|'week'
  auctionMode             String        @default("offline") @map("auction_mode")
  auctionDay              Int?          @map("auction_day")
  auctionTime             String?       @map("auction_time")
  complianceStatus        String        @default("draft") @map("compliance_status")
  remarks                 String?       @db.Text
  chitType                String        @default("unregistered") @map("chit_type")
  auctionType             String        @default("open_manual") @map("auction_type")
  fixedDiscountPct        Decimal?      @map("fixed_discount_pct") @db.Decimal(5, 2)
  commissionBasis         String        @default("BID_DISCOUNT") @map("commission_basis")
  gstPct                  Decimal?      @map("gst_pct") @db.Decimal(5, 2)
  dividendPolicy          String        @default("ALL_MEMBERS") @map("dividend_policy")
  dividendDistribution    String        @default("ADJUST_NEXT_DUE") @map("dividend_distribution")
  dividendRounding        Int           @default(0) @map("dividend_rounding")
  minDiscountPct          Decimal?      @map("min_discount_pct") @db.Decimal(5, 2)
  bidStartAtCommission    Boolean       @default(true) @map("bid_start_at_commission")
  bidIncrement            Decimal?      @map("bid_increment") @db.Decimal(14, 2)
  tieBreakRule            String        @default("EARLIEST_BID") @map("tie_break_rule")
  winnerInterestType      String        @default("NONE") @map("winner_interest_type")
  winnerInterestValue     Decimal?      @map("winner_interest_value") @db.Decimal(14, 2)
  winnerInterestPeriods   Int?          @map("winner_interest_periods")
  // Live-room admission policy: 'auto' admits joiners instantly; 'approval'
  // parks them in a waiting room until the organizer admits/denies.
  roomAdmission           String        @default("auto") @map("room_admission")
  // Organizer bell ("going once/twice/sold"): manual + automatic ring after a
  // quiet interval; bellAutoClose closes the room on the final bell.
  bellEnabled             Boolean       @default(true) @map("bell_enabled")
  bellIntervalSeconds     Int           @default(60) @map("bell_interval_seconds")
  bellCount               Int           @default(3) @map("bell_count")
  bellAutoClose           Boolean       @default(true) @map("bell_auto_close")
  hasForemanTicket        Boolean       @default(false) @map("has_foreman_ticket")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  deletedAt               DateTime?     @map("deleted_at")
  auctions                ChitAuction[]
  branch                  Branch?       @relation(fields: [branchId], references: [id])
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members                 ChitMember[]

  @@index([tenantId, appType, status])
  @@index([tenantId, appType, complianceStatus])
  @@index([branchId], map: "chit_groups_branch_id_fkey")
  @@map("chit_groups")
}

model ChitMember {
  id                String                  @id @default(cuid())
  chitGroupId       String                  @map("chit_group_id")
  customerId        String                  @map("customer_id")
  memberNumber      Int                     @map("member_number")
  ticketNo          String?                 @map("ticket_no")
  fractionNo        String?                 @map("fraction_no")
  ticketShare       Decimal                 @default(1.00) @map("ticket_share") @db.Decimal(4, 2)
  subscriberStatus  String                  @default("active") @map("subscriber_status")
  agreementStatus   String                  @default("pending") @map("agreement_status")
  agreementSignedAt DateTime?               @map("agreement_signed_at")
  nomineeName       String?                 @map("nominee_name")
  nomineeRelation   String?                 @map("nominee_relation")
  nomineePhone      String?                 @map("nominee_phone")
  introducedBy      String?                 @map("introduced_by")
  isForemanTicket   Boolean                 @default(false) @map("is_foreman_ticket")
  hasWon            Boolean                 @default(false) @map("has_won")
  wonAt             DateTime?               @map("won_at")
  joinedAt          DateTime                @default(now()) @map("joined_at")
  wonAuctions       ChitAuction[]           @relation("AuctionWinner")
  bids              ChitBid[]
  attendance        ChitAuctionAttendance[]
  chitGroup         ChitGroup               @relation(fields: [chitGroupId], references: [id], onDelete: Cascade)
  customer          Customer                @relation(fields: [customerId], references: [id])
  subscriptions     ChitSubscription[]

  @@unique([chitGroupId, customerId])
  @@unique([chitGroupId, memberNumber])
  @@index([customerId], map: "chit_members_customer_id_fkey")
  @@index([chitGroupId, ticketNo])
  @@map("chit_members")
}

model ChitAuction {
  id               String                  @id @default(cuid())
  chitGroupId      String                  @map("chit_group_id")
  periodNumber     Int                     @map("period_number")
  auctionDate      DateTime                @map("auction_date") @db.Date
  scheduledAt      DateTime?               @map("scheduled_at")
  startedAt        DateTime?               @map("started_at")
  completedAt      DateTime?               @map("completed_at")
  noticeStatus     String                  @default("pending") @map("notice_status")
  minutesText      String?                 @map("minutes_text") @db.Text
  confirmedById    String?                 @map("confirmed_by_id")
  confirmedAt      DateTime?               @map("confirmed_at")
  payoutStatus     String                  @default("not_ready") @map("payout_status")
  biddingOpensAt   DateTime?               @map("bidding_opens_at")
  biddingClosesAt  DateTime?               @map("bidding_closes_at")
  autoExtendSeconds Int                    @default(0) @map("auto_extend_seconds")
  roomStatus       String                  @default("scheduled") @map("room_status")
  // Bell anchor resets on room open + every accepted bid; the lazy evaluator
  // (lib/chits/bell.ts) derives bellsRung from wall-clock time since this.
  bellAnchorAt     DateTime?               @map("bell_anchor_at")
  bellsRung        Int                     @default(0) @map("bells_rung")
  winnerMemberId   String?                 @map("winner_member_id")
  prizeAmount      Decimal?                @map("prize_amount") @db.Decimal(14, 2)
  bidDiscount      Decimal?                @map("bid_discount") @db.Decimal(14, 2)
  commission       Decimal?                @db.Decimal(14, 2)
  dividend         Decimal?                @db.Decimal(14, 2)
  gstAmount        Decimal                 @default(0.00) @map("gst_amount") @db.Decimal(14, 2)
  roundingIncome   Decimal                 @default(0.00) @map("rounding_income") @db.Decimal(14, 2)
  status           String                  @default("pending")
  createdAt        DateTime                @default(now()) @map("created_at")
  // DEPRECATED — unused since the auction-engine unification (Release 1). The
  // roomStatus/biddingOpensAt/biddingClosesAt/autoExtendSeconds fields above
  // are the single canonical live-room engine; these columns are kept only to
  // avoid a destructive migration and back no active code path.
  endsAt           DateTime?               @map("ends_at")
  countdownSeconds Int?                    @map("countdown_seconds")
  minBidDecrement  Decimal?                @map("min_bid_decrement") @db.Decimal(14, 2)
  currentBestBidId String?                 @unique @map("current_best_bid_id")
  operatorId       String?                 @map("operator_id")
  closedAt         DateTime?               @map("closed_at")
  reminder1DayAt   DateTime?               @map("reminder_1day_at")
  reminder1HourAt  DateTime?               @map("reminder_1hour_at")
  resultNotifiedAt DateTime?               @map("result_notified_at")
  dividendNotifiedAt DateTime?             @map("dividend_notified_at")
  bids             ChitBid[]
  attendance       ChitAuctionAttendance[]
  events           ChitAuctionEvent[]
  roomMessages     ChitRoomMessage[]
  chitGroup        ChitGroup               @relation(fields: [chitGroupId], references: [id], onDelete: Cascade)
  winnerMember     ChitMember?             @relation("AuctionWinner", fields: [winnerMemberId], references: [id])

  @@unique([chitGroupId, periodNumber])
  @@index([chitGroupId, status])
  @@index([winnerMemberId], map: "chit_auctions_winner_member_id_fkey")
  @@map("chit_auctions")
}

// Unified ChitBid model for both legacy/manual/open room auctions and live auctions
model ChitBid {
  id             String      @id @default(cuid())
  tenantId       String?     @map("tenant_id")
  branchId       String?     @map("branch_id")
  chitGroupId    String      @map("chit_group_id")
  auctionId      String      @map("auction_id")
  periodNumber   Int?        @map("period_number")
  memberId       String      @map("member_id")
  prizeAmount    Decimal?    @map("prize_amount") @db.Decimal(14, 2)
  discountAmount Decimal?    @map("discount_amount") @db.Decimal(14, 2)
  bidAmount      Decimal?    @map("bid_amount") @db.Decimal(14, 2)
  bidDiscount    Decimal?    @map("bid_discount") @db.Decimal(14, 2)
  kind           String      @default("bid") // bid | pass | retracted
  source         String      @default("tap") // tap | voice | remote
  transcript     String?     @db.Text
  // Voice-bid audio proof → ChitDocument(documentType='bid_audio'). Clip is
  // captured ONLY inside the push-to-talk bid gesture, never ambiently.
  audioDocumentId String?    @map("audio_document_id")
  seq            Int? // monotonic per auction — ordering + undo
  bidTime        DateTime    @default(now()) @map("bid_time")
  status         String      @default("valid")
  remarks        String?     @db.Text
  idempotencyKey String?     @map("idempotency_key")
  createdById    String?     @map("created_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  auction        ChitAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  member         ChitMember  @relation(fields: [memberId], references: [id])

  @@unique([auctionId, seq])
  @@unique([auctionId, idempotencyKey], map: "chit_bids_auction_idempotency_key")
  @@index([tenantId, branchId, chitGroupId])
  @@index([auctionId, createdAt])
  @@index([auctionId, status])
  @@index([memberId])
  @@map("chit_bids")
}

// Legal-grade "minutes" trail for a live auction — every open/extend/announce/
// pass/close/winner/cancel event, in order.
model ChitAuctionEvent {
  id          String      @id @default(cuid())
  auctionId   String      @map("auction_id")
  type        String // open | extend | announce | pass | close | winner | cancel
  message     String?     @db.Text
  memberId    String?     @map("member_id")
  amount      Decimal?    @db.Decimal(14, 2)
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  auction     ChitAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
  @@map("chit_auction_events")
}

model ChitSubscription {
  id               String        @id @default(cuid())
  memberId         String        @map("member_id")
  periodNumber     Int           @map("period_number")
  dueDate          DateTime      @map("due_date") @db.Date
