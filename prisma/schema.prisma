// ── Agent / branch cash float (wallet) ───────────────────────────────
// Cash-in-hand ledger: admin/superadmin RELEASE company cash to an agent's
// account; disbursing a loan DEBITS it; collecting a repayment CREDITS it.
// Branch cash account funds direct disbursements by admin/superadmin.
model AgentAccount {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  appType   String   @default("microlending") @map("app_type")
  agentId   String   @map("agent_id")
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, appType, agentId], map: "agent_accounts_tenant_app_agent_key")
  @@map("agent_accounts")
}

model BranchCashAccount {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  appType   String   @default("microlending") @map("app_type")
  branchId  String   @map("branch_id")
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, appType, branchId], map: "branch_cash_accounts_tenant_app_branch_key")
  @@map("branch_cash_accounts")
}

model WalletTransaction {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  appType      String   @default("microlending") @map("app_type")
  accountKind  String   @map("account_kind") // agent | branch
  agentId      String?  @map("agent_id")
  branchId     String?  @map("branch_id")
  type         String // release | disburse | collection | inject | adjustment
  amount       Decimal  @db.Decimal(18, 2) // signed: + credit, - debit
  balanceAfter Decimal  @map("balance_after") @db.Decimal(18, 2)
  refType      String?  @map("ref_type") // loan | collection_entry | manual
  refId        String?  @map("ref_id")
  note         String?  @db.Text
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, appType, agentId], map: "wallet_tx_tenant_app_agent_idx")
  @@index([tenantId, appType, branchId], map: "wallet_tx_tenant_app_branch_idx")
  @@index([createdAt], map: "wallet_tx_created_at_idx")
  @@map("wallet_transactions")
}

// ── mCollect-A: route batch collection run ───────────────────────────────────
// A thin session wrapper that lets an agent open one collection RUN over a route,
// collect from every due customer on a single (offline-capable) sheet, then
// reconcile + deposit the day's cash as one unit. Standalone table (scalar FK
// ids, no Prisma relations) following the Affiliate-table convention so the
// large Tenant/Branch models stay untouched. Entries link back via
// CollectionEntry.runId; DailyCollection remains the per-agent/day rollup.
model CollectionRun {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  branchId         String?   @map("branch_id")
  appType          String    @default("microlending") @map("app_type")
  agentId          String    @map("agent_id")
  routeId          String?   @map("route_id")
  date             DateTime  @db.Date
  status           String    @default("open") // open | collecting | closed | reconciled
  // snapshot taken at open
  expectedTotal    Decimal   @default(0) @map("expected_total") @db.Decimal(14, 2)
  stopsExpected    Int       @default(0) @map("stops_expected")
  // running totals
  collectedTotal   Decimal   @default(0) @map("collected_total") @db.Decimal(14, 2)
  stopsCollected   Int       @default(0) @map("stops_collected")
  cashCollected    Decimal   @default(0) @map("cash_collected") @db.Decimal(14, 2)
  digitalCollected Decimal   @default(0) @map("digital_collected") @db.Decimal(14, 2)
  // reconciliation
  cashDeposited    Decimal?  @map("cash_deposited") @db.Decimal(14, 2)
  depositRef       String?   @map("deposit_ref")
  varianceAmount   Decimal?  @map("variance_amount") @db.Decimal(14, 2)
  // session GPS / device proof
  openedAt         DateTime? @map("opened_at")
  closedAt         DateTime? @map("closed_at")
  reconciledAt     DateTime? @map("reconciled_at")
  openLat          Float?    @map("open_lat")
  openLng          Float?    @map("open_lng")
  notes            String?   @db.Text
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, appType, agentId, routeId, date], map: "collection_runs_agent_route_day_key")
  @@index([tenantId, status])
  @@index([agentId, date])
  @@index([branchId])
  @@map("collection_runs")
}

// ── e-NACH / e-Mandate ────────────────────────────────────────────────────────

model NachMandate {
  id         String @id @default(cuid())
  tenantId   String @map("tenant_id")
  loanId     String @unique @map("loan_id")
  customerId String @map("customer_id")

  // Razorpay objects
  razorpayCustomerId String? @map("razorpay_customer_id")
  razorpayOrderId    String? @map("razorpay_order_id")
  razorpayTokenId    String? @map("razorpay_token_id") // populated after auth
  razorpayPaymentId  String? @map("razorpay_payment_id") // auth payment id

  authLink String? @map("auth_link") @db.Text
  authType String  @default("netbanking") @map("auth_type")
  // netbanking | debitcard | aadhaar

  // Bank account details
  accountHolderName String  @map("account_holder_name")
  accountNumber     String  @map("account_number")
  accountType       String  @default("savings") @map("account_type")
  ifscCode          String  @map("ifsc_code")
  bankName          String? @map("bank_name")

  maxAmount Decimal @map("max_amount") @db.Decimal(12, 2)
  frequency String  @default("as_presented") @map("frequency")
  // as_presented | monthly | weekly | daily

  status String @default("created") @map("status")
  // created | pending_auth | active | paused | cancelled | rejected | expired

  activatedAt     DateTime? @map("activated_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledById   String?   @map("cancelled_by_id")
  cancelReason    String?   @map("cancel_reason") @db.Text
  rejectionReason String?   @map("rejection_reason") @db.Text

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loan          Loan               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id])
  cancelledBy   User?              @relation("NachCanceller", fields: [cancelledById], references: [id])
  createdBy     User?              @relation("NachCreator", fields: [createdById], references: [id])
  presentations NachPresentation[]

  @@index([tenantId, status])
  @@index([customerId])
  @@index([razorpayOrderId])
  @@map("nach_mandates")
}

model NachPresentation {
  id           String  @id @default(cuid())
  mandateId    String  @map("mandate_id")
  instalmentId String? @map("instalment_id")
  loanId       String  @map("loan_id")
  tenantId     String  @map("tenant_id")

  razorpayOrderId   String? @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")

  amount      Decimal   @db.Decimal(12, 2)
  presentedAt DateTime  @default(now()) @map("presented_at")
  settledAt   DateTime? @map("settled_at")

  status String @default("pending") @map("status")
  // pending | submitted | success | failed | bounced

  failureCode   String?   @map("failure_code")
  failureReason String?   @map("failure_reason") @db.Text
  retryCount    Int       @default(0) @map("retry_count")
  nextRetryAt   DateTime? @map("next_retry_at")

  collectionEntryId String? @unique @map("collection_entry_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mandate NachMandate @relation(fields: [mandateId], references: [id])

  @@index([mandateId, status])
  @@index([loanId])
  @@index([instalmentId])
  @@index([razorpayPaymentId])
  @@index([razorpayOrderId])
  @@map("nach_presentations")
}
