    "seed:chits": "tsx scripts/seed-chit-demo.ts",
    "backfill:chits": "tsx scripts/backfill-chit-schema.ts",
    "self-heal": "node scripts/self-heal/healer.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "gen:tests": "node scripts/self-heal/generate-tests.mjs",
    "test:links": "npx playwright test e2e/link-check.spec.ts",
    "test:e2e-auth-rbac": "tsx tests/e2e-business/authRbacTenantIsolation.test.ts",
    "test:e2e-customers": "tsx tests/e2e-business/customerKycApproval.test.ts",
    "test:e2e-loans": "tsx tests/e2e-business/loanPackageCreationApproval.test.ts",
    "test:e2e-business-core": "npm run test:e2e-business-core-phase1",
    "test:e2e-business-core-phase1": "npm run test:e2e-auth-rbac && npm run test:e2e-customers && npm run test:e2e-loans",
    "test:e2e-money-core": "tsx tests/e2e-business/moneyMovementCore.test.ts",
    "test:e2e-reports": "tsx tests/e2e-business/reportsExports.test.ts",
    "test:e2e-security-abuse": "tsx tests/e2e-business/securityAbuse.test.ts",
    "test:e2e-business-core-phase4": "npm run test:e2e-reports && npm run test:e2e-security-abuse",
    "test:e2e-risk": "tsx tests/e2e-business/penaltyOverdueNpaForeclosure.test.ts",
    "test:e2e-cron": "tsx tests/e2e-business/cronJobsIdempotency.test.ts",
    "test:e2e-gold": "tsx tests/e2e-business/goldLoanAutomation.test.ts",
    "test:e2e-payments-nach": "tsx tests/e2e-business/borrowerPaymentsNach.test.ts",
    "test:e2e-mobile-api": "tsx tests/e2e-business/mobileAgentApiParity.test.ts",
    "test:e2e-special-modules": "tsx tests/e2e-business/chitsVehicleSpecialModules.test.ts",
    "test:e2e-chits": "tsx tests/e2e-business/chitsAutomation.test.ts",
    "test:e2e-chits-ui": "npx playwright test -c tests/e2e/new-modules/playwright.config.ts 01-chits.spec.ts --project=chromium",
    "test:e2e-business-phase5": "npm run test:e2e-risk && npm run test:e2e-cron && npm run test:e2e-gold && npm run test:e2e-payments-nach && npm run test:e2e-mobile-api && npm run test:e2e-special-modules",
    "test:e2e-ui-critical": "node scripts/run-zolofund-ui-e2e.mjs",
    "test:e2e-auth-compat": "node scripts/run-zolofund-ui-e2e.mjs --auth-compat",
    "test:e2e-agent-portal": "node scripts/run-zolofund-agent-portal-e2e.mjs",
    "test:e2e-ui-critical-headed": "node scripts/run-zolofund-ui-e2e.mjs --headed",
    "test:e2e-final": "npm run test:e2e-business-core && npm run test:e2e-business-core-phase4 && npm run test:e2e-business-phase5 && npm run test:e2e-ui-critical"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.107.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.0.0",
    "jose": "^5.9.6",
    "mysql2": "^3.22.3",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sharp": "0.35.3",
    "socks-proxy-agent": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1",
    "nodemailer": "^9.0.1"
  }
