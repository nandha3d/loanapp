    "test:ci": "npm run test:repayments && npm run test:loan-calculator && npm run test:interest-only && npm run test:roles && npm run test:branch-scoping && npm run test:approval-notifications && npm run test:security",
    "test:coverage": "c8 --check-coverage --lines 40 --functions 45 --branches 60 --statements 40 --exclude=lib/utils.ts npm run test:ci",
    "typecheck": "tsc --noEmit",
    "test:proxy-public": "tsx tests/proxyPublicPaths.test.ts",
    "test:ui-assets": "tsx tests/uiAssets.test.ts",
    "test:file-upload": "tsx tests/fileUpload.test.ts",
    "test:origination-integrity": "tsx tests/originationIntegrity.test.ts",
    "ui-map:roles": "node scripts/check-role-ui-map.mjs",
    "db:validate": "npx prisma validate",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-gold-master": "npx tsx prisma/seed_gold_master.ts",
    "db:seed-gold-demo": "npx tsx prisma/seed_gold_demo.ts",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "test:loan-calculator": "tsx tests/loanCalculator.test.ts",
    "test:interest-only": "tsx tests/interestOnly.test.ts",
    "test:roles": "tsx tests/roles.test.ts",
    "test:branch-scoping": "tsx tests/branchScoping.test.ts",
    "test:approval-notifications": "tsx tests/approvalNotifications.test.ts",
    "test:gold": "tsx tests/goldValuation.test.ts && tsx tests/goldOrnaments.test.ts && tsx tests/pledgeInterest.test.ts && tsx tests/goldServicing.test.ts",
    "test:chits:calculation": "tsx tests/chits/chitCalculation.test.ts",
    "test:chits:winner-interest": "tsx tests/chits/chitWinnerInterest.test.ts",
    "test:chits:security": "tsx tests/chits/chitSecurity.test.ts",
    "test:chits:frequency": "tsx tests/chits/chitFrequency.test.ts",
    "test:chits:bid-floor": "tsx tests/chits/chitBidFloor.test.ts",
    "test:chits:bell": "tsx tests/chits/chitBell.test.ts",
    "test:chits": "npm run test:chits:calculation && npm run test:chits:winner-interest && npm run test:chits:security && npm run test:chits:frequency && npm run test:chits:bid-floor && npm run test:chits:bell",
