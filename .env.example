# ─────────────────────────────────────────────────────────────────────────────
# Application environment variables – copy to .env and fill in real values.
# Never commit your .env file (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL="mysql://user:password@localhost:3306/loanapp"

# Session secret used to sign web (NextAuth), middleware, borrower-portal, and
# — as a fallback — mobile API tokens. Must be at least 32 characters.
# Set EITHER NEXTAUTH_SECRET or AUTH_SECRET; both names are accepted everywhere.
# At least one of these is REQUIRED — the app refuses to boot in production
# without it.
NEXTAUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"
# AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"

# ─────────────────────────────────────────────────────────────────────────────
# TRUST_PROXY
#
# Set to "true" ONLY when the application is running behind a trusted reverse
# proxy (e.g. nginx, Hostinger's load balancer) that populates the standard
# proxy headers:
#   • x-forwarded-for – comma-separated chain of IPs; the leftmost value is
#     the original client address and is used for rate limiting.
#   • x-real-ip       – single client IP set by some proxies.
#
# Leaving this unset (or setting it to anything other than "true") is safe:
# the rate limiter will ignore those headers and fall back to request.ip.
#
# WARNING – do not enable this flag unless you really are behind a trusted
# proxy.  If you set TRUST_PROXY=true on a server that is exposed directly to
# the internet (without a proxy), clients can forge these headers and bypass
# IP-based rate limiting entirely by spoofing any IP they choose.
# ─────────────────────────────────────────────────────────────────────────────
TRUST_PROXY=false

# Cron job authorization token (Bearer scheme, used by scheduled routes)
CRON_SECRET="replace-with-a-random-cron-secret"

# Razorpay (payment gateway)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Domain and URL configuration
#
# In a one-app local setup, NEXT_PUBLIC_API_URL can be empty so v1 API calls use
# the same origin. In a split deployment, point it at the backend/API domain.
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
WEB_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN=""
APP_ROOT_DOMAIN=""
CORS_EXTRA_ORIGINS=""

# Mobile API (v1 routes for Flutter app).
# OPTIONAL: if unset, mobile tokens are signed with NEXTAUTH_SECRET/AUTH_SECRET.
# Setting a dedicated secret here is recommended (keeps mobile tokens isolated
# from the web session secret) but is not required for the app to work.
MOBILE_JWT_SECRET="replace-with-64-char-hex-secret"

# Bureau integration (CRIF / CIBIL)
CRIF_API_URL=""
CRIF_USERNAME=""
CRIF_PASSWORD=""
CRIF_MEMBER_ID=""
CIBIL_API_URL=""
CIBIL_CONSUMER_KEY=""
CIBIL_CONSUMER_SECRET=""
CIBIL_MEMBER_ID=""

# Digio KYC (Aadhaar OTP + Video KYC)
DIGIO_CLIENT_ID=""
DIGIO_CLIENT_SECRET=""
DIGIO_BASE_URL="https://ext.digio.in:444"
DIGIO_WEBHOOK_SECRET=""

# MSG91 SMS / WhatsApp
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="LNTRCK"
MSG91_WHATSAPP_NUMBER=""
