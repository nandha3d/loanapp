# ─────────────────────────────────────────────────────────────────────────────
# Application environment variables – copy to .env and fill in real values.
# Never commit your .env file (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL="mysql://user:password@localhost:3306/loanapp"

# Authentication secret used for signing borrower session JWTs and OTPs.
# Must be at least 32 characters. Accepted as either NEXTAUTH_SECRET or AUTH_SECRET.
NEXTAUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"
# AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"

# ─────────────────────────────────────────────────────────────────────────────
# TRUST_PROXY
#
# Set to "true" ONLY when the application is running behind a trusted reverse
# proxy (e.g. nginx, Hostinger's load balancer) that populates the standard
# proxy headers:
#   • x-forwarded-for – comma-separated chain of IPs; the leftmost value is
#     the original client address and is used for rate limiting.
#   • x-real-ip       – single client IP set by some proxies.
#
# Leaving this unset (or setting it to anything other than "true") is safe:
# the rate limiter will ignore those headers and fall back to request.ip.
#
# WARNING – do not enable this flag unless you really are behind a trusted
# proxy.  If you set TRUST_PROXY=true on a server that is exposed directly to
# the internet (without a proxy), clients can forge these headers and bypass
# IP-based rate limiting entirely by spoofing any IP they choose.
# ─────────────────────────────────────────────────────────────────────────────
TRUST_PROXY=false

# Cron job authorization token (Bearer scheme, used by scheduled routes)
CRON_SECRET="replace-with-a-random-cron-secret"

# Razorpay (payment gateway)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
