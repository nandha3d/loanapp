+   snapshotDate    DateTime  @map("snapshot_date") @db.Date
+ 
+   category        String    // asset category at snapshot
+   outstandingAmt  Decimal   @map("outstanding_amt") @db.Decimal(12, 2)
+   provisioningRate Decimal  @map("provisioning_rate") @db.Decimal(6, 2)
+   provisioningAmt  Decimal  @map("provisioning_amt") @db.Decimal(12, 2)
+   isSecured       Boolean   @default(false) @map("is_secured")
+ 
+   createdAt       DateTime  @default(now()) @map("created_at")
+ 
+   loan            Loan      @relation(fields: [loanId], references: [id])
+   tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+ 
+   @@unique([loanId, snapshotDate])
+   @@index([tenantId, snapshotDate])
+   @@map("loan_provisioning")
+ }
