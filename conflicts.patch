+ /// Superadmin-assigned global module access for an admin or agent.
+ /// Determines which app-modules (microlending, autofinance, chitfunds) the user can see.
+ model UserModule {
+   id           String   @id @default(cuid())
+   userId       String   @map("user_id")
+   appType      String   @map("app_type")
+   assignedById String?  @map("assigned_by_id")
+   assignedAt   DateTime @default(now()) @map("assigned_at")
+ 
+   user       User  @relation("UserModuleUser", fields: [userId], references: [id], onDelete: Cascade)
+   assignedBy User? @relation("UserModuleAssigner", fields: [assignedById], references: [id])
+ 
+   @@unique([userId, appType])
+   @@index([userId])
+   @@map("user_modules")
+ }
